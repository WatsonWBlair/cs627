# CS627 Docker Environment Configuration
# Copy this file to .env and modify as needed

# Device Configuration
# Options: cuda, cpu, auto (auto-detect)
DEVICE=auto

# Token Pre-generation Configuration
BATCH_SIZE=32                  # Batch size for token generation
OUTPUT_DIR=/workspace/data/pregenerated_tokens
TOKEN_DIR=/workspace/data/pregenerated_tokens/mosi

# Adapter Training Configuration
ADAPTER_BATCH_SIZE=256         # Larger batch size for adapter training
LEARNING_RATE=0.001            # Higher LR for adapter training
EPOCHS=50                      # Number of training epochs
ADAPTER_HIDDEN_SIZE=512        # Hidden layer size for adapters
ADAPTER_LAYERS=2               # Number of hidden layers
USE_AMP=1                      # Use automatic mixed precision
GRADIENT_ACCUMULATION=1        # Gradient accumulation steps

# Legacy Training Configuration (kept for compatibility)
MOMENTUM=0.999
QUEUE_SIZE=4096
TEMPERATURE=0.07
SEMANTIC_DIM=1024

# Dataset Configuration
TRAIN_RATIO=0.7
VAL_RATIO=0.15
RANDOM_SEED=42
NUM_WORKERS=0                  # Set to 0 for Windows compatibility
SKIP_DOWNLOAD=1                # Skip SDK downloads (assume pre-staged data)

# Data Paths (container paths)
MOSI_DATA_PATH=/workspace/data/cmumosi/mosi/
AUDIO_DIR=/workspace/data/cmumosi/audio/
VIDEO_DIR=/workspace/data/cmumosi/frames/

# Model Weights and Results Directories
OPTIMAL_WEIGHTS_DIR=/workspace/OptimalWeights
CANDIDATE_WEIGHTS_DIR=/workspace/CandidateWeights
RESULTS_DIR=/workspace/Results/adapter_training

# Instance Identification
INSTANCE_ID=docker

# Docker Hub Configuration
DOCKER_HUB_USERNAME=watsonwb
DOCKER_HUB_REPO=cs627-svs

# Image Tags
GPU_TAG=gpu
CPU_TAG=cpu
DEV_TAG=dev
LATEST_TAG=latest

# Jupyter Configuration (for dev container)
JUPYTER_PORT=8888
TENSORBOARD_PORT=6006

# S3 Configuration (Optional)
USE_S3=0
S3_BUCKET=cs627-svs-data
S3_REGION=us-east-1
S3_DATA_PREFIX=data/cmumosi/
S3_WEIGHTS_PREFIX=OptimalWeights/

# Resource Limits (optional)
# Uncomment to set memory limits
# MEMORY_LIMIT=16g
# CPU_LIMIT=8

# GPU Configuration
# Number of GPUs to use (for multi-GPU systems)
# GPU_COUNT=1

# Logging
LOG_LEVEL=INFO
LOG_DIR=/workspace/logs