# CS627 SVS Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your environment.
# NEVER commit .env to version control!
#
# Table of Contents
# -----------------
# 1. Data Paths
# 2. Training Hyperparameters
# 3. MoCo Training
# 4. Adapter Configuration
# 5. Output Paths
# 6. S3 Cloud Storage
# 7. SSH/Remote Training
#
# ============================================================================

# ============================================================================
# 1. Data Paths
# ============================================================================
SKIP_DOWNLOAD=1                     # Skip SDK downloads (1=assume pre-staged data)
MOSI_DATA_PATH=data/cmumosi/mosi/   # MOSI metadata directory
AUDIO_DIR=data/cmumosi/audio/       # Audio segments directory
VIDEO_DIR=data/cmumosi/frames/      # Video frames directory

# ============================================================================
# 2. Training Hyperparameters
# ============================================================================
BATCH_SIZE=32                       # Training batch size
LEARNING_RATE=0.0001                # Learning rate for optimizer
EPOCHS=50                           # Number of training epochs
DEVICE=cuda                         # Device: cuda, cpu, or auto

# Dataset splits
TRAIN_RATIO=0.7                     # Training split ratio
VAL_RATIO=0.15                      # Validation split ratio (test = 1 - train - val)
RANDOM_SEED=42                      # Seed for reproducibility

# ============================================================================
# 3. MoCo Training
# ============================================================================
USE_MOCO=1                          # Enable MoCo (1=yes, 0=in-batch negatives only)
QUEUE_SIZE=4096                     # MoCo memory queue size
MOMENTUM=0.999                      # Momentum encoder coefficient (0-1)
TEMPERATURE=0.07                    # InfoNCE loss temperature

# ============================================================================
# 4. Adapter Configuration
# ============================================================================
ADAPTER_HIDDEN_SIZE=512             # Hidden layer size for MLP adapters
ADAPTER_LAYERS=2                    # Number of hidden layers
USE_AMP=1                           # Enable automatic mixed precision (1=yes)
GRADIENT_ACCUMULATION=1             # Gradient accumulation steps

# Token-based training paths
TOKEN_DIR=data/pregenerated_tokens/mosi  # Pre-generated token directory
OUTPUT_DIR=data/pregenerated_tokens      # Token output directory

# ============================================================================
# 5. Output Paths
# ============================================================================
OPTIMAL_WEIGHTS_DIR=OptimalWeights      # Production adapter weights
CANDIDATE_WEIGHTS_DIR=CandidateWeights  # Experimental weights
RESULTS_DIR=Results/adapter_training    # Training results output

# ============================================================================
# 6. S3 Cloud Storage (Optional)
# ============================================================================
USE_S3=0                            # Enable S3 data loading (0=disabled)
S3_BUCKET=cs627-svs-data            # S3 bucket name
S3_REGION=us-east-1                 # AWS region
S3_DATA_PREFIX=data/cmumosi/        # S3 prefix for training data
S3_WEIGHTS_PREFIX=OptimalWeights/   # S3 prefix for weights

# ============================================================================
# 7. SSH/Remote Training (Optional)
# ============================================================================
CLOUD_USER=ubuntu                   # SSH username
CLOUD_HOST=your-instance-ip         # Instance IP or hostname
CLOUD_SSH_KEY=~/.ssh/id_rsa         # Path to SSH private key
CLOUD_PORT=22                       # SSH port
CLOUD_PROJECT_DIR=~/cs627           # Project directory on remote
