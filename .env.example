# ==============================================================================
# Cloud Instance Configuration
# ==============================================================================
# Copy this file to .env and fill in your cloud instance details
# The .env file is gitignored and will not be committed

# SSH Configuration
CLOUD_USER=ubuntu                           # SSH username (ubuntu, ec2-user, etc.)
CLOUD_HOST=your-instance-ip-or-hostname     # Instance IP or hostname
CLOUD_SSH_KEY=~/.ssh/id_rsa                 # Path to SSH private key (optional)
CLOUD_PORT=22                               # SSH port (usually 22)

# Project paths
CLOUD_PROJECT_DIR=~/cs627                   # Project directory on cloud instance
LOCAL_PROJECT_DIR=.                         # Local project directory (usually current dir)

# ==============================================================================
# Training Configuration
# ==============================================================================

# Training hyperparameters
BATCH_SIZE=32                               # Training batch size
QUEUE_SIZE=4096                             # MoCo memory queue size
EPOCHS=100                                  # Number of training epochs
LEARNING_RATE=0.0001                        # Learning rate

# Device configuration
DEVICE=cuda                                 # Device to use (cuda, cpu, mps)

# ==============================================================================
# Data Configuration
# ==============================================================================

# MOSI dataset paths
MOSI_DATA_PATH=data/cmumosi/mosi/           # MOSI metadata directory
AUDIO_DIR=data/cmumosi/audio/               # Audio segments directory
VIDEO_DIR=data/cmumosi/frames/              # Video frames directory

# Data splits
TRAIN_SPLIT=train                           # Training split name
VAL_SPLIT=valid                             # Validation split name
TEST_SPLIT=test                             # Test split name

# ==============================================================================
# Output Paths
# ==============================================================================

# Adapter weights
OPTIMAL_WEIGHTS_DIR=OptimalWeights/         # Directory for trained adapter weights

# Results and logs
RESULTS_DIR=results/                        # Base directory for all results
TRAINING_REPORTS_DIR=training_reports/      # Training logs and reports
EVALUATION_DIR=results/evaluation/          # Evaluation results

# ==============================================================================
# Model Configuration
# ==============================================================================

# Semantic vector dimension
SEMANTIC_DIM=1024                           # Dimension of semantic vector space

# Adapter architecture
ADAPTER_HIDDEN_SIZE=200                     # Hidden layer size for adapters
ADAPTER_HIDDEN_LAYERS=2                     # Number of hidden layers

# ==============================================================================
# Cloud Provider Specific (Optional)
# ==============================================================================

# AWS Configuration (if using AWS EC2)
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# AWS_INSTANCE_ID=i-1234567890abcdef0

# GCP Configuration (if using GCP)
# GCP_PROJECT_ID=your-project-id
# GCP_ZONE=us-central1-a
# GCP_INSTANCE_NAME=your-instance-name

# Azure Configuration (if using Azure)
# AZURE_RESOURCE_GROUP=your-resource-group
# AZURE_VM_NAME=your-vm-name

# ==============================================================================
# Advanced Configuration
# ==============================================================================

# Logging
LOG_LEVEL=INFO                              # Logging level (DEBUG, INFO, WARNING, ERROR)
WANDB_API_KEY=                              # Weights & Biases API key (optional)

# Evaluation
EVAL_BATCH_SIZE=32                          # Batch size for evaluation
MAX_EVAL_SAMPLES=                           # Max samples for evaluation (empty = all)

# Parallelization
NUM_WORKERS=4                               # Number of dataloader workers
