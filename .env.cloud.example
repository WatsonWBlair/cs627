# ==============================================================================
# Cloud Training Configuration
# ==============================================================================
# Optimized environment variables for cloud GPU training instances
# Copy this to .env.cloud and update with your cloud instance details
# ==============================================================================

# ==============================================================================
# SSH Connection
# ==============================================================================
CLOUD_USER=ubuntu                           # SSH username
CLOUD_HOST=your-instance-ip                 # Instance IP or hostname
CLOUD_SSH_KEY=~/.ssh/your-key.pem           # SSH private key path
CLOUD_PORT=22                               # SSH port
CLOUD_PROJECT_DIR=~/cs627                   # Remote project directory

# ==============================================================================
# Training Hyperparameters (for g5.4xlarge / A10G)
# ==============================================================================
BATCH_SIZE=64                               # Batch size (32 for T4, 64 for A10G/V100)
QUEUE_SIZE=8192                             # MoCo queue size (4096 for T4, 8192+ for A10G/V100)
EPOCHS=100                                  # Training epochs
LEARNING_RATE=0.0001                        # Learning rate
MOMENTUM=0.999                              # Momentum for momentum encoders
TEMPERATURE=0.07                            # Temperature for InfoNCE loss

# ==============================================================================
# Model Architecture
# ==============================================================================
SEMANTIC_DIM=1024                           # Semantic vector dimension
ADAPTER_HIDDEN_SIZE=200                     # Adapter hidden layer size
ADAPTER_HIDDEN_LAYERS=2                     # Number of adapter hidden layers

# ==============================================================================
# Data Paths (on cloud instance)
# ==============================================================================
MOSI_DATA_PATH=data/cmumosi/mosi/           # MOSI metadata
AUDIO_DIR=data/cmumosi/audio/               # Audio segments
VIDEO_DIR=data/cmumosi/frames/              # Video frames

# ==============================================================================
# Output Paths (on cloud instance)
# ==============================================================================
OPTIMAL_WEIGHTS_DIR=OptimalWeights/         # Where to save trained weights
RESULTS_DIR=results/                        # Training results
TRAINING_REPORTS_DIR=training_reports/      # Logs and metrics

# ==============================================================================
# AWS Configuration (if using AWS)
# ==============================================================================
AWS_PROFILE=default                         # AWS CLI profile
AWS_REGION=us-east-1                        # AWS region

# ==============================================================================
# Advanced (optional)
# ==============================================================================
NUM_WORKERS=4                               # Dataloader workers (Linux only)
CUDNN_BENCHMARK=true                        # Enable cuDNN auto-tuner
TF32_ENABLED=true                           # Enable TF32 on Ampere GPUs
