# CS627 Cloud Training Configuration
# ============================================================================
# Optimized settings for GPU cloud instances (g5.4xlarge / A10G, etc.)
# Copy to .env.cloud and customize. See .env.example for variable descriptions.
#
# Table of Contents
# -----------------
# 1. SSH Connection
# 2. Cloud-Optimized Hyperparameters
# 3. Data Paths
# 4. Output Paths
#
# ============================================================================

# ============================================================================
# 1. SSH Connection
# ============================================================================
CLOUD_USER=ubuntu
CLOUD_HOST=your-instance-ip
CLOUD_SSH_KEY=~/.ssh/your-key.pem
CLOUD_PORT=22
CLOUD_PROJECT_DIR=~/cs627

# ============================================================================
# 2. Cloud-Optimized Hyperparameters
# ============================================================================
# Higher values for GPU instances with more memory
BATCH_SIZE=64                       # 32 for T4, 64 for A10G/V100
QUEUE_SIZE=8192                     # 4096 for T4, 8192+ for A10G/V100
EPOCHS=100
LEARNING_RATE=0.0001
MOMENTUM=0.999
TEMPERATURE=0.07

# Adapter training
ADAPTER_HIDDEN_SIZE=512
ADAPTER_LAYERS=2
USE_AMP=1
GRADIENT_ACCUMULATION=1

# Device
DEVICE=cuda

# ============================================================================
# 3. Data Paths
# ============================================================================
MOSI_DATA_PATH=data/cmumosi/mosi/
AUDIO_DIR=data/cmumosi/audio/
VIDEO_DIR=data/cmumosi/frames/
TOKEN_DIR=data/pregenerated_tokens/mosi
SKIP_DOWNLOAD=1

# ============================================================================
# 4. Output Paths
# ============================================================================
OPTIMAL_WEIGHTS_DIR=OptimalWeights
CANDIDATE_WEIGHTS_DIR=CandidateWeights
RESULTS_DIR=Results/adapter_training
