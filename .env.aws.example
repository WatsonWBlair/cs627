# AWS Configuration for CS627 Token-Based Training
# Copy this file to .env.aws and update with your values

# =====================================
# Region Configuration
# =====================================
AWS_DEFAULT_REGION=us-east-1

# =====================================
# S3 Configuration
# =====================================
# Your unique S3 bucket name
S3_BUCKET=cs627-training-XXXXXX  # UPDATE: Replace XXXXXX with unique identifier

# S3 paths for different data types
S3_TOKEN_PATH=s3://${S3_BUCKET}/tokens/
S3_WEIGHTS_PATH=s3://${S3_BUCKET}/weights/
S3_RESULTS_PATH=s3://${S3_BUCKET}/results/
S3_LOGS_PATH=s3://${S3_BUCKET}/logs/
S3_DATASETS_PATH=s3://${S3_BUCKET}/datasets/

# S3 storage class for cost optimization
S3_STORAGE_CLASS=STANDARD  # Options: STANDARD, STANDARD_IA, GLACIER_IR

# =====================================
# IAM Configuration
# =====================================
IAM_ROLE=cs627-ec2-role
INSTANCE_PROFILE=cs627-profile

# =====================================
# Security Configuration
# =====================================
SECURITY_GROUP_NAME=cs627-training
# Security group ID will be populated by setup script
SECURITY_GROUP_ID=

# =====================================
# EC2 Instance Configuration
# =====================================
# Instance type for training
INSTANCE_TYPE=g5.4xlarge  # Options: g5.xlarge, g5.2xlarge, g5.4xlarge, p3.2xlarge

# SSH key pair name (MUST UPDATE)
KEY_NAME=your-key-name  # UPDATE: Your AWS SSH key pair name

# AMI ID (leave empty to use latest Deep Learning AMI)
AMI_ID=

# Instance storage
EBS_VOLUME_SIZE=100  # GB
EBS_VOLUME_TYPE=gp3  # Options: gp3, gp2, io1, io2

# =====================================
# Training Configuration
# =====================================
# Token generation settings
TOKEN_GEN_BATCH_SIZE=32  # Adjust based on instance memory
TOKEN_GEN_NUM_WORKERS=4

# Adapter training settings
ADAPTER_BATCH_SIZE=256
ADAPTER_LEARNING_RATE=0.001
ADAPTER_EPOCHS=50
ADAPTER_HIDDEN_SIZE=512
ADAPTER_NUM_LAYERS=2

# Performance optimizations
USE_AMP=1  # Mixed precision training
GRADIENT_ACCUMULATION=1
CACHE_SIZE=2000
USE_GRADIENT_CHECKPOINTING=0

# Memory optimization
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
OMP_NUM_THREADS=4

# =====================================
# Monitoring Configuration
# =====================================
ENABLE_CLOUDWATCH=1
CLOUDWATCH_NAMESPACE=CS627/Training
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR

# =====================================
# Cost Optimization
# =====================================
# Auto-termination settings
AUTO_TERMINATE_HOURS=0  # Set to >0 to auto-terminate after N hours
USE_SPOT_INSTANCES=0  # Set to 1 to use spot instances (70% savings)
SPOT_MAX_PRICE=  # Leave empty for on-demand price

# =====================================
# Notification Configuration (Optional)
# =====================================
# SNS topic for training notifications
SNS_TOPIC_ARN=
NOTIFY_ON_COMPLETE=0
NOTIFY_ON_ERROR=1

# =====================================
# Advanced Configuration
# =====================================
# Parallel upload/download
S3_MULTIPART_THRESHOLD=64MB
S3_MAX_CONCURRENCY=10
S3_MAX_BANDWIDTH=100MB/s

# Checkpointing
CHECKPOINT_FREQUENCY=10  # Save every N epochs
KEEP_N_CHECKPOINTS=3  # Keep only N most recent checkpoints

# Distributed training (future)
DISTRIBUTED_TRAINING=0
NUM_NODES=1
NUM_GPUS_PER_NODE=1