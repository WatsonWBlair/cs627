# Environment Configuration Template
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env to version control!

# ============================================================================
# Training Hyperparameters
# ============================================================================

# Batch size for training (adjust based on GPU memory)
BATCH_SIZE=32

# Learning rate for Adam optimizer
LEARNING_RATE=0.0001

# Number of training epochs
EPOCHS=30

# Momentum coefficient for momentum encoder (0-1, higher = slower updates)
MOMENTUM=0.999

# Size of negative sample queue (larger = better performance, more memory)
# Recommended: 4096 (16GB GPU), 16384 (32GB GPU), 65536 (40GB+ GPU)
QUEUE_SIZE=4096

# Temperature for InfoNCE loss (lower = stricter alignment)
TEMPERATURE=0.07

# Dimension of semantic vector space
SEMANTIC_DIM=1024

# ============================================================================
# Data Paths
# ============================================================================

# Path to MOSI dataset metadata
MOSI_DATA_PATH=data/cmumosi/mosi/

# Path to extracted audio segments
AUDIO_DIR=data/cmumosi/audio/

# Path to extracted video frames
VIDEO_DIR=data/cmumosi/frames/

# ============================================================================
# Weight Management
# ============================================================================

# Directory for production-ready adapter weights (version controlled)
OPTIMAL_WEIGHTS_DIR=OptimalWeights

# Directory for experimental weights from training runs (NOT version controlled)
# Uses format: {CANDIDATE_WEIGHTS_DIR}/{instance_id}_{timestamp}/
CANDIDATE_WEIGHTS_DIR=CandidateWeights

# Instance identifier for cloud training (e.g., aws-p3-2xlarge, gcp-v100)
# Leave empty to auto-generate from hostname
INSTANCE_ID=

# ============================================================================
# Cloud & External Services (NEVER commit credentials!)
# ============================================================================

# HuggingFace API token (for downloading gated models)
# Get token from: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases API key (for experiment tracking - optional)
# Get key from: https://wandb.ai/authorize
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS credentials (for S3 uploads - optional)
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# Training Settings
# ============================================================================

# Dataset split ratios
TRAIN_RATIO=0.7
VAL_RATIO=0.15
# TEST_RATIO is automatically calculated as 1 - TRAIN_RATIO - VAL_RATIO

# Random seed for reproducibility
RANDOM_SEED=42

# Number of dataloader workers (set to 0 for Windows compatibility)
NUM_WORKERS=0

# Enable mixed precision training (faster on modern GPUs)
USE_FP16=false

# Checkpoint saving frequency (every N steps, 0 = end of epoch only)
CHECKPOINT_FREQUENCY=1000

# ============================================================================
# Logging & Monitoring
# ============================================================================

# Directory for training logs and reports
LOGS_DIR=training_reports

# Enable Weights & Biases logging
ENABLE_WANDB=false

# Weights & Biases project name
WANDB_PROJECT=cs627-multimodal

# Weights & Biases run name (leave empty to auto-generate)
WANDB_RUN_NAME=
